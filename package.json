{
  "name": "whisper-mvp",
  "version": "1.0.0",
  "description": "Anonymous partner feedback platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "build:prod": "npm install && cd server && npm install && cd ../client && npm install && npm run build",
    "start": "NODE_ENV=production cd server && node index.js",
    "postinstall": "cd server && npm install && cd ../client && npm install"
  },
  "keywords": ["feedback", "anonymous", "reviews"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vercel/postgres": "^0.5.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "nanoid": "^5.0.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
